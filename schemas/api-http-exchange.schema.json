{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/api-http-exchange.schema.json",
  "title": "ApiHttpExchange",
  "description": "Portable request/response fixture for HTTP API contract examples.",
  "type": "object",
  "required": ["contractVersion", "id", "description", "request", "response"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "DELETE"] },
        "path": { "type": "string", "minLength": 1 },
        "headers": { "type": "object" },
        "body": { "type": "object" },
        "rawBody": { "type": "string" }
      }
    },
    "response": {
      "type": "object",
      "required": ["status", "body"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer" },
        "headers": { "type": "object" },
        "body": { "type": "object" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
