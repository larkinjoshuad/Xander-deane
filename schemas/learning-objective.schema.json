{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/learning-objective.schema.json",
  "title": "LearningObjective",
  "description": "Portable definition of what a learner should understand or be able to do.",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "subject",
    "locale",
    "title",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "enum": [
        "math",
        "language",
        "science",
        "history",
        "arts",
        "social_studies",
        "computer_science",
        "world_languages",
        "life_skills",
        "custom"
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
