{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/problem.schema.json",
  "title": "Problem",
  "description": "Subject-neutral educational prompt with modality and workspace metadata.",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "objectiveId",
    "subject",
    "locale",
    "prompt",
    "difficulty",
    "expectedAnswer",
    "interactionModes",
    "workspace"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objectiveId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "enum": [
        "math",
        "language",
        "science",
        "history",
        "arts",
        "social_studies",
        "computer_science",
        "world_languages",
        "life_skills",
        "custom"
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "expectedAnswer": {},
    "acceptableAnswers": {
      "type": "array",
      "items": {},
      "default": []
    },
    "interactionModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "audio",
          "video",
          "drawing",
          "touch",
          "gesture",
          "manipulative",
          "camera"
        ]
      }
    },
    "workspace": {
      "type": "object",
      "required": [
        "kind",
        "state"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "object"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
