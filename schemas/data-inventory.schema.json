{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/data-inventory.schema.json",
  "title": "DataInventory",
  "description": "Risk-first inventory that classifies contract records before real learner data, school records, AI transcripts, or voucher/ESA funds are handled.",
  "type": "object",
  "required": ["contractVersion", "generatedAt", "mode", "records"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["synthetic_architecture_prototype", "venture_discovery", "real_learner_pilot"] },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "contractName",
          "schemaPath",
          "classification",
          "piiRisk",
          "realDataAllowed",
          "recordTypes",
          "requiresConsentScopes",
          "retentionPolicyRequired",
          "exportRequired",
          "deletionRequired",
          "productionRequirements"
        ],
        "additionalProperties": false,
        "properties": {
          "contractName": { "type": "string", "minLength": 1 },
          "schemaPath": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "enum": ["public_contract", "synthetic_safe", "restricted", "prohibited_until_review"] },
          "piiRisk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
          "realDataAllowed": { "type": "boolean" },
          "recordTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["contract_metadata", "curriculum", "learner_profile", "learner_work", "session_state", "ai_context", "ai_output", "consent", "safety", "audit", "identity", "access_control", "device", "billing", "voucher", "retention", "api_exchange"] }
          },
          "requiresConsentScopes": {
            "type": "array",
            "items": { "type": "string", "enum": ["ai_tutoring", "personalization", "progress_tracking", "analytics", "voucher_billing", "guardian_notifications", "data_export"] }
          },
          "retentionPolicyRequired": { "type": "boolean" },
          "exportRequired": { "type": "boolean" },
          "deletionRequired": { "type": "boolean" },
          "productionRequirements": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string", "default": "" }
        }
      }
    }
  }
}
