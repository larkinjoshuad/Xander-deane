{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/activity-set.schema.json",
  "title": "ActivitySet",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "syntheticOnly", "id", "subject", "title", "kind", "hint", "rounds"],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "syntheticOnly": { "const": true },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "subject": { "enum": ["toddler", "math", "language", "science"] },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["choice", "order", "memory"] },
    "hint": { "type": "string", "minLength": 1 },
    "rounds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["prompt", "choices", "answer"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1 },
          "preview": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visual" } },
          "choices": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "visual": { "$ref": "#/$defs/visual" }
              }
            }
          },
          "answer": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "visual": { "type": "string", "pattern": "^(color:(red|blue|yellow|green|pink|orange)|shape:(circle|square|triangle|oval|star|heart)|size:(circle|square|triangle|oval|star|heart):(small|medium|large)|dots:[1-3]|object:(apple|cup|ball|shoe))$" }
  }
}
