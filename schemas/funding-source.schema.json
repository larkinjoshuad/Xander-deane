{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/funding-source.schema.json",
  "title": "FundingSource",
  "description": "State, scholarship, voucher, or ESA funding program that can pay for eligible educational services.",
  "type": "object",
  "required": [
    "contractVersion",
    "id",
    "programName",
    "programType",
    "jurisdiction",
    "administrator",
    "eligibleExpenseCategories",
    "paymentRails",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "programName": { "type": "string", "minLength": 1 },
    "programType": {
      "type": "string",
      "enum": ["esa", "voucher", "tax_credit_scholarship", "microgrant", "direct_pay", "reimbursement", "custom"]
    },
    "jurisdiction": {
      "type": "object",
      "required": ["country", "region"],
      "additionalProperties": false,
      "properties": {
        "country": { "type": "string", "minLength": 2 },
        "region": { "type": "string", "minLength": 2 }
      }
    },
    "administrator": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "website": { "type": "string", "minLength": 1 },
        "contactEmail": { "type": "string", "minLength": 1 }
      }
    },
    "eligibleExpenseCategories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "tuition",
          "curriculum",
          "instructional_materials",
          "online_learning",
          "tutoring",
          "assessment",
          "therapy",
          "technology",
          "fees",
          "custom"
        ]
      }
    },
    "paymentRails": {
      "type": "object",
      "required": ["directPay", "marketplace", "reimbursement", "purchaseOrder"],
      "additionalProperties": false,
      "properties": {
        "directPay": { "type": "boolean" },
        "marketplace": { "type": "boolean" },
        "reimbursement": { "type": "boolean" },
        "purchaseOrder": { "type": "boolean" }
      }
    },
    "documentationRequirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["researching", "provider_application_required", "provider_pending", "active", "paused", "retired"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
