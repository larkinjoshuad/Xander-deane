{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xander-deane.dev/schemas/activity-progress.schema.json",
  "title": "ActivityProgress",
  "description": "Local synthetic-demo resume state; not a learner profile or evidence of mastery. Runtime also validates against the current activity content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "syntheticOnly", "activityId", "contentKey", "currentRound", "rounds"],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "syntheticOnly": { "const": true },
    "activityId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "contentKey": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "currentRound": { "type": "integer", "minimum": 0, "maximum": 99 },
    "rounds": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "answer", "checked", "deck", "exposed", "matched"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 99 },
          "answer": { "$ref": "#/$defs/uniqueIds" },
          "checked": { "type": "boolean" },
          "deck": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } },
          "exposed": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 31 } },
          "matched": { "$ref": "#/$defs/uniqueIds" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "uniqueIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
