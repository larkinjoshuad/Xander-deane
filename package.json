{
  "name": "xander-deane-learning-core",
  "version": "0.1.0",
  "private": true,
  "description": "Subject-agnostic base layer for a multimodal AI education platform.",
  "type": "module",
  "scripts": {
    "build:public": "node scripts/build-public.js",
    "preview:public": "node scripts/preview-public.js",
    "test:public": "node scripts/verify-public-browser.js",
    "test": "node --test",
    "test:browser": "node --test test/browser-flow.test.js",
    "validate:fixtures": "node scripts/validate-fixtures.js",
    "validate:data-inventory": "node scripts/validate-data-inventory.js",
    "replay:api-fixtures": "node scripts/replay-api-fixtures.js",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "start:tutor": "node scripts/tutor-server.js",
    "start:session-api": "node scripts/session-api-server.js",
    "test:device": "node scripts/device-qa.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@fontsource-variable/nunito": "5.3.0",
    "@playwright/test": "^1.60.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.47.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
